NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/ai_debug_saas

JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
INTEGRATION_ENCRYPTION_KEY=change_this_to_a_separate_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_TTL_SECONDS=300

CLIENT_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
# Vercel production:
# CLIENT_ORIGINS=https://your-admin.vercel.app,https://your-customer.vercel.app,https://your-developer.vercel.app,https://your-super-admin.vercel.app

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Force <no-reply@example.com>"

REDIS_URL=

CUSTOMER_URL=http://localhost:3001
DEVELOPER_URL=http://localhost:3003

GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_PRIVATE_KEY_PATH=

API_PUBLIC_URL=http://localhost:5000
ADMIN_URL=http://localhost:3002
# Vercel production:
# API_PUBLIC_URL=https://your-backend.vercel.app
# ADMIN_URL=https://your-admin.vercel.app
# CUSTOMER_URL=https://your-customer.vercel.app
# DEVELOPER_URL=https://your-developer.vercel.app

AI_EXTERNAL_CALLS_ENABLED=false
AI_PROVIDER_ORDER=gemini,groq,openai,cerebras
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
AI_MAX_CONTEXT_FILES=8
AI_MAX_CONTEXT_CHARS=30000
AI_MAX_CONTEXT_CHARS_PER_FILE=8000

# Request/attachment limits
JSON_BODY_LIMIT=16mb
TICKET_MAX_ATTACHMENTS=4
TICKET_MAX_ATTACHMENT_BYTES=1500000
AI_TIMEOUT_MS=45000

# Optional local scripts
SEED_PASSWORD=Force@12345
SEED_RESET=false
CLEANUP_KEEP_EMAILS=admin@force.local
